{
  "version": "",
  "description": "Shortcuts for Command Palette: folders of your choice in the Command Palette main search. Installs the Store-signed package of the GitHub release.",
  "homepage": "https://github.com/xxthunder/CmdPal.Extension.Shortcuts",
  "license": "MIT",
  "url": "",
  "hash": "",
  "installer": {
    "script": [
      "if ($PSVersionTable.PSVersion.Major -ge 6) { Import-Module Appx -UseWindowsPowerShell 3>$null }",
      "Add-AppxPackage -Path \"$dir\\$fname\" -ForceApplicationShutdown"
    ]
  },
  "uninstaller": {
    "script": [
      "if ($cmd -eq 'update') { return }",
      "if ($PSVersionTable.PSVersion.Major -ge 6) { Import-Module Appx -UseWindowsPowerShell 3>$null }",
      "Get-AppxPackage karnomag.ShortcutsforCommandPalette | Remove-AppxPackage"
    ]
  }
}
